# The repo lives and runs on Linux — every text file MUST be stored and checked
# out as LF. `text=auto` normalises any CRLF an editor sneaks in back to LF on
# commit; `eol=lf` forces LF on checkout regardless of platform. This is the
# blanket rule; binary files are auto-detected and left untouched. Without it an
# editor re-saving a file as CRLF shows the WHOLE file as changed (a false diff).
* text=auto eol=lf

# Host deploy scripts + systemd units run on Linux — they MUST be LF, or a CRLF
# shebang/line breaks them on the VPS. Force LF regardless of the checkout platform.
*.sh text eol=lf
deploy/host/*.path text eol=lf
deploy/host/*.service text eol=lf
